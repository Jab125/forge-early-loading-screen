{
	"schemaVersion": 1,
	"id": "early-loading-screen",
	"version": "${version}",
	"name": "Forge Early Loading Screen",
	"description": "Direct port of earlydisplay from FML",
	"accessWidener": "early-loading-screen.accesswidener",
	"authors": [
		"Jab125"
	],
	"contributors": [
		"NeoForged Team",
		"MinecraftForge Team"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/forge-early-loading-screen-fabric",
		"sources": "https://github.com/Jab125/forge-early-loading-screen",
		"issues": "https://github.com/Jab125/forge-early-loading-screen/issues"
	},
	"license": "LGPL-2.1-only",
	"icon": "assets/early-loading-screen/icon.png",
	"environment": "client",
	"entrypoints": {
		"early-loading-screen-hook-provider": ["com.jab125.earlyloadingscreen.util.Provider"]
	},
	"mixins": [
		"early-loading-screen.mixins.json",
		"early-loading-screen-plugin.mixins.json",
		"early-loading-screen-1.20.1.mixins.json"
	],
	"languageAdapters": {
		"els-asddsjkh": "com.jab125.earlyloadingscreen.util.HooksLaInit"
	},
	"depends": {
		"fabricloader": ">=0.15.1",
		"minecraft": [
			"~1.20.1",
			"~1.21-"
		],
		"java": ">=17"
	},
	"recommends": {
		"minecraft": [
			"~1.20.3",
			"~1.21-"
		]
	},
	"breaks": {
		"quilt_loader": "*",
		"springboard": "*"
	},
	"custom": {
		"sodium:options": {
			"mixin.workarounds.context_creation": false
		},
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/s2AtrCEKCn",
				"modmenu.kofi": "https://ko-fi.com/Jab125/"
			}
		}
	}
}